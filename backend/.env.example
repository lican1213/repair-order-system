SECRET_KEY=please-change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_DAYS=30
SHOP_NAME=诚信家电维修
SHOP_PHONE=13800138000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisStrongPassword123!
DATABASE_URL=sqlite:///./data/repair.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
PUBLIC_UPLOAD_MAX_FILES=5

# 高德地图 Web服务 API（逆地理编码）
# 申请地址: https://console.amap.com/dev/key/app
# 注意: 此处填写 Web服务 Key，不是 JSAPI Key
AMAP_WEB_SERVICE_KEY=
AMAP_REGEOCODE_ENABLED=false

# 新订单 Webhook 通知（默认关闭）
# 开启后，客户提交订单成功会异步 POST 一份脱敏的新单摘要。
# provider 可选 generic / wecom。企业微信机器人请使用 wecom。
ORDER_WEBHOOK_ENABLED=false
ORDER_WEBHOOK_PROVIDER=wecom
# 默认不向企业微信发送客户姓名、电话、完整地址和描述。
# 如果企业微信群是内部接单群，并且确实需要完整联系信息，可改为 true。
ORDER_WECOM_INCLUDE_PRIVATE_FIELDS=false
ORDER_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=REPLACE_WITH_YOUR_KEY
ORDER_WEBHOOK_TIMEOUT_SECONDS=3
APP_BASE_URL=https://your-domain.example
